meta {
  name: Auth-Capture (CB MOP 3DS) (MREC + 3DS)
  type: http
  seq: 13
}

post {
  url: {{online_url}}/payments
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{request-id}}
  merchant-id: {{merchant-id}}
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
    "captureMethod": "MANUAL",
    "amount": 100000,
    "currency": "EUR",
    "initiatorType": "MERCHANT",
    "accountOnFile": "STORED",
    "isAmountFinal": true,
    "merchant": {
      "merchantSoftware": {
        "companyName": "{{$randomCompanyName}}",
        "productName": "{{$randomProduct}}",
        "version": "2.0"
      }
    },
    "recurring": {
      "recurringSequence": "SUBSEQUENT",
      "recurringNumber": 1,
      "isVariableAmount": false,
      "paymentAgreementExpiryDate": "2040-10-30"
    },
    "paymentMethodType": {
      "card": {
        "cvv": "063",
        "preferredPaymentNetworkRoutingCode": "CB",
        "preferredRoutingInitiatorCode": "MERCHANT",
        "accountNumber": "{{cardNum}}",
        "expiry": {
          "month": 11,
          "year": 2027
        },
        "originalNetworkTransactionId": "{{networkTransactionId}}",
        "authentication": {
          "initialThreeDSAuthenticationResults": {
            "initialThreeDSAuthenticationAmount": 2000,
            "initialThreeDSProgramProtocol": "2.2.0",
            "initialThreeDSAuthenticationTimestamp": "{{$isoTimestamp}}",
            "initialThreeDSAuthenticationTransactionId": "{{3dsAuthTransactionId}}",
            "initialThreeDSAuthenticationMethodCode": "FRICTIONLESS",
            "initialThreeDSChallengeType": "NO_CHALLENGE",
            "initialIssuerAssignedAuthenticationFraudScore": "05"
          }
        }
      }
    },
    "merchantOrderNumber": "{{merchantOrderNumber}}",
    "accountHolder": {
      "referenceId": "{{$randomAlphaNumeric}}"
    }
  }
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setEnvVar("request-id", require("uuid").v4())
  
  // Generate merchantOrderNumber using UNIX timestamp and store in variable
  bru.setEnvVar("merchantOrderNumber", Math.floor(Date.now() / 1000));
}

script:post-response {
  // Set transactionId to variable for further use
  if(res.body.transactionId) {
  bru.setEnvVar("transactionId", res.body.transactionId);
  }
  
  // Set requestId to variable for further use
  if(res.body.requestId) {
  bru.setEnvVar("authRequestId", res.body.requestId);
  }
  
  // Set networkTransactionId to variable for further use
  if(res.body.paymentMethodType.card.networkResponse.networkTransactionId) {
  bru.setEnvVar("networkTransactionId", res.body.paymentMethodType.card.networkResponse.networkTransactionId);
  }
}
