meta {
  name: Auth (Soft & Sub Merchant)
  type: http
  seq: 17
}

post {
  url: {{online_url}}/payments
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{request-id}}
  merchant-id: {{merchant-id}}
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
    "captureMethod": "MANUAL",
    "amount": 1550,
    "currency": "USD",
    "statementDescriptor": "{{$randomCatchPhrase}}",
    "initiatorType": "CARDHOLDER",
    "accountOnFile": "STORED",
    "paymentMethodType": {
      "card": {
        "accountNumber": "{{cardNum}}",
        "expiry": {
          "month": 12,
          "year": 2027
        },
        "cvv": 111
      }
    },
    "recurring": {
      "recurringSequence": "FIRST"
    },
    "merchant": {
      "merchantSoftware": {
        "companyName": "{{$randomCompanyName}}",
        "productName": "{{$randomProduct}}",
        "version": "2.0"
      },
      "merchantCategoryCode": "5945",
      "softMerchant": {
        "name": "{{$randomFullName}}",
        "phone": "{{$randomPhoneNumber}}",
        "email": "{{$randomEmail}}",
        "url": "payments.jpmorgan.com",
        "address": {
          "line1": "{{$randomStreetAddress}}",
          "city": "{{$randomCity}}",
          "state": "FL",
          "countryCode": "USA",
          "postalCode": "33626"
        },
        "merchantPurchaseDescription": "{{$randomCatchPhrase}}"
      }
    },
    "subMerchantSupplementalData": {
      "merchantIdentification": {
        "sellerIdentifier": "{{$randomBankAccount}}",
        "serviceEntitlementNumber": "{{$randomBankAccount}}",
        "subMerchantId": "{{$randomBankAccount}}"
      }
    }
  }
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setEnvVar("request-id", require("uuid").v4())
  
  // Generate merchantOrderNumber using UNIX timestamp and store in variable
  bru.setEnvVar("merchantOrderNumber", Math.floor(Date.now() / 1000));
}

script:post-response {
  // Set transactionId to variable for further use
  if(res.body.transactionId) {
  bru.setEnvVar("transactionId", res.body.transactionId);
  }
  
  // Set requestId to variable for further use
  if(res.body.requestId) {
  bru.setEnvVar("authRequestId", res.body.requestId);
  }
}
