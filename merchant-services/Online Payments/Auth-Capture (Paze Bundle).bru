meta {
  name: Auth-Capture (Paze Bundle)
  type: http
  seq: 18
}

post {
  url: {{online_url}}/payments
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{request-id}}
  merchant-id: {{merchant-id}}
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
    "captureMethod": "NOW",
    "amount": 100000,
    "isAmountFinal": true,
    "currency": "USD",
    "initiatorType": "CARDHOLDER",
    "accountOnFile": "NOT_STORED",
    "merchant": {
      "merchantSoftware": {
        "companyName": "{{$randomCompanyName}}",
        "productName": "{{$randomProduct}}",
        "version": "2.0"
      }
    },
    "paymentMethodType": {
      "paze": {
        "encryptedPaymentBundle": {
          "encryptedPayload": "IwMUZxaGpIZmhQQ3NibEswTXQ4WExNQ1ZRMGtOS21DX2ZHRllybkFRjRTUldJT2t6SkRWcHJzdlctNERYYThUUGl5YUR1cEN4TGEwaHFyaHBuYktlelctZGM2dzFkcWFVWFIzTmtvNjF3S3lJLkpVRHN1SXNFQnRxZGFPUlc1ZDBTSFEifQ.BUuxJn2DWV2His9s7gpOqp7-NQFSlrpPGzIzA7pDZO2BJ1bx4Zwv18N0aYkd10OB5SRFk3WLo6O_GcKaCZT3RfES0kOLY93SAAA1k1s0Uo-gnI-HBLFmgqr0lvtrlVUESnGefyjROrmYb3nVGC9YgaztuJWIHrk8PrPWb0SgGMDhroQ-oXH6Z3uvP6A5RyVmSpgWkCJuKKACKkEDm87ZJygNf8HrF1wz4cEiJzKwsym_JhfUAVIuGbM3HD9jEhLF0ms3HRkV0xR_0TQvlMVw6zApZ3BCDClbHP4hoA_buPn8z0IGZhe7KsOC-TwxHtkHy8zaoQ9b_vEdONXRT_fLNA"
        }
      }
    }
  }
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setEnvVar("request-id", require("uuid").v4())
  
  // Generate merchantOrderNumber using UNIX timestamp and store in variable
  bru.setEnvVar("merchantOrderNumber", Math.floor(Date.now() / 1000));
}

script:post-response {
  // Set transactionId to variable for further use
  if(res.body.transactionId) {
  bru.setEnvVar("transactionId", res.body.transactionId);
  }
  
  // Set requestId to variable for further use
  if(res.body.requestId) {
  bru.setEnvVar("authRequestId", res.body.requestId);
  }
}
