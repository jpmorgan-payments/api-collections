meta {
  name: Auth-Capture LPM (Klarna)
  type: http
  seq: 8
}

post {
  url: {{online_url}}/payments
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{request-id}}
  merchant-id: {{merchant-id}}
  platform-id: 6000699815
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
    "captureMethod": "NOW",
    "amount": 2000,
    "currency": "USD",
    "merchant": {
      "merchantSoftware": {
        "companyName": "{{$randomCompanyName}}",
        "productName": "{{$randomProductName}}",
        "version": "5.x"
      }
    },
    "initiatorType": "CARDHOLDER",
    "accountOnFile": "NOT_STORED",
    "isAmountFinal": true,
    "paymentMethodType": {
      "klarna": {
        "preferredLanguage": "en_US",
        "redirectedPayment": {
          "merchantReturnUrl": "https://your-merchant-domain.example.com/return"
        }
      }
    },
    "merchantOrderNumber": "{{merchantOrderNumber}}",
    "accountHolder": {
      "billingAddress": {
        "line1": "{{$randomStreetAddress}}",
        "city": "{{$randomCity}}",
        "state": "MA",
        "postalCode": "02777",
        "countryCode": "USA"
      },
      "firstName": "{{$randomFirstName}}",
      "lastName": "{{$randomLastName}}",
      "fullName": "{{$randomFullName}}",
      "countryOfNationality": "US",
      "email": "{{$randomEmail}}"
    },
    "shipTo": {
      "shippingAddress": {
        "line1": "{{$randomStreetAddress}}",
        "city": "{{$randomCity}}",
        "state": "MA",
        "postalCode": "02777",
        "countryCode": "USA"
      },
      "firstName": "{{$randomFirstName}}",
      "lastName": "{{$randomLastName}}",
      "fullName": "{{$randomFullName}}",
      "shippingDescription": "TC",
      "shippingCarrierName": "DHL"
    },
    "retailAddenda": {
      "level3": {
        "lineItems": [
          {
            "lineItemDescriptionText": "test",
            "unitPriceAmount": 9000,
            "lineItemUnitQuantity": 1,
            "taxInclusiveLineItemTotalAmount": "9000"
          }
        ]
      },
      "taxAmount": "2000",
      "isTaxable": true
    }
  }
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setEnvVar("request-id", require("uuid").v4())
  
  // Generate merchantOrderNumber using UNIX timestamp and store in variable
  bru.setEnvVar("merchantOrderNumber", Math.floor(Date.now() / 1000));
}

script:post-response {
  // Set transactionId to variable for further use
  if(res.body.transactionId) {
  bru.setEnvVar("LPMtransactionId", res.body.transactionId);
  }
  
  // Set requestId to variable for further use
  if(res.body.requestId) {
  bru.setEnvVar("authLPMRequestId", res.body.requestId);
  }
}
