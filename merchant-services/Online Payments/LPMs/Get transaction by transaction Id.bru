meta {
  name: Get transaction by transaction Id
  type: http
  seq: 82
}

get {
  url: {{online_url}}/payments/{{LPMtransactionId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{requestId}}
  merchant-id: {{merchantId}}
}

auth:bearer {
  token: {{auth-token}}
}
