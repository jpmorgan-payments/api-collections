meta {
  name: Auth LPM (Trustly)
  type: http
  seq: 7
}

post {
  url: {{online_url}}/payments
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{requestId}}
  merchant-id: {{merchantId}}
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
    "amount": 1000,
    "currency": "EUR",
    "merchant": {
      "merchantId": "{{merchantId}}",
      "merchantSoftware": {
        "companyName": "{{$randomCompanyName}}",
        "productName": "{{$randomProduct}}",
        "version": "2.0"
      },
      "softMerchant": {
        "name": "{{$randomCompanyName}}",
        "address": {
          "line1": "{{$randomStreetAddress}}",
          "line2": "{{$randomStreetAddress}}",
          "state": "{{$randomCountryCode}}",
          "city": "{{$randomCity}}",
          "postalCode": "33626",
          "countryCode": "SWE"
        }
      }
    },
    "paymentMethodType": {
      "trustly": {
        "preferredLanguage": "en-US",
        "redirectedPayment": {
          "merchantReturnUrl": "https://your-merchant-domain.example.com/return"
        }
      }
    },
    "accountHolder": {
      "fullName": "{{$randomFullName}}",
      "referenceId": "{{$randomAlphaNumeric}}",
      "nationalId": "{{$randomInt}}",
      "billingAddress": {
        "line1": "{{$randomStreetAddress}}",
        "line2": "{{$randomStreetAddress}}",
        "state": "{{$randomCountryCode}}",
        "city": "{{$randomCity}}",
        "postalCode": "33626",
        "countryCode": "SWE"
      }
    }
  }
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setVar("requestId", require("uuid").v4())
  
  // Generate merchantOrderNumber using UNIX timestamp and store in variable
  bru.setVar("merchantOrderNumber", Math.floor(Date.now() / 1000));
}

script:post-response {
  // Set transactionId to variable for further use
  if(res.body.transactionId) {
  bru.setVar("LPMtransactionId", res.body.transactionId);
  }
  
  // Set requestId to variable for further use
  if(res.body.requestId) {
  bru.setVar("authLPMRequestId", res.body.requestId);
  }
}
