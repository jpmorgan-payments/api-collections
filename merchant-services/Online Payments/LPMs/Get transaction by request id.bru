meta {
  name: Get transaction by request id
  type: http
  seq: 7
}

get {
  url: {{online_url}}/payments?requestIdentifier={{authLPMRequestId}}
  body: json
  auth: inherit
}

params:query {
  requestIdentifier: {{authLPMRequestId}}
}

headers {
  Content-Type: application/json
  request-id: {{requestId}}
  merchant-id: {{merchantId}}
}

auth:bearer {
  token: {{auth-token}}
}
