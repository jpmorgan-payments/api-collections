meta {
  name: Auth-Capture (Google Pay Bundle)
  type: http
  seq: 19
}

post {
  url: {{online_url}}/payments
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{request-id}}
  merchant-id: {{merchant-id}}
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
    "captureMethod": "NOW",
    "amount": 1000,
    "isAmountFinal": true,
    "currency": "USD",
    "initiatorType": "CARDHOLDER",
    "accountOnFile": "NOT_STORED",
    "merchant": {
      "merchantSoftware": {
        "companyName": "Payment Company",
        "productName": "Application Name",
        "version": 1.235
      }
    },
    "paymentMethodType": {
      "googlepay": {
        "latLong": "1,1",
        "encryptedPaymentBundle": {
          "encryptedPayload": "{\"encryptedMessage\":\"\\u003d\\u003d\",\"ephemeralPublicKey\":\"BOn0Hz0PzJXBkmNqKwiGJw85THbRPFXRkocMC0quNbvjXu9XqVvzRzs0luXY2paaHK77L9GZyYCApvRqeUGNVHE\\u003d\",\"tag\":\"BycEuXvdD2iZNtzQpHOOkeVVSVVU/x5vveBEQH8T8n0\\u003d\"}",
          "encryptedPaymentHeader": {
            "ephemeralPublicKey": "BOn0Hz0P532422BkmNqKwiGJw85THbRPFXRkocMC0quNbvjXu9XqVvzRzs0luXY2paaHK77L9GZyYCApvRqeUGNVHE="
          },
          "signature": "MEUCIQCFj2Jg88231243zGidKUuReuEHAZG6wgm1BOGsx4GqFTlQIgdyaTRY27n1HUpRAvyRq9ilF8zhJOKJIZ7X31231YNkc4U=",
          "protocolVersion": "ECv1"
        }
      }
    }
  }
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setEnvVar("request-id", require("uuid").v4())
  
  // Generate merchantOrderNumber using UNIX timestamp and store in variable
  bru.setEnvVar("merchantOrderNumber", Math.floor(Date.now() / 1000));
}

script:post-response {
  // Set transactionId to variable for further use
  if(res.body.transactionId) {
  bru.setEnvVar("transactionId", res.body.transactionId);
  }
  
  // Set requestId to variable for further use
  if(res.body.requestId) {
  bru.setEnvVar("authRequestId", res.body.requestId);
  }
}
