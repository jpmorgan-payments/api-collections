meta {
  name: Get Fraud Check Details by RequestID
  type: http
  seq: 9
}

get {
  url: {{online_url}}/fraudcheck?requestId={{fraudRequestId}}
  body: json
  auth: inherit
}

params:query {
  requestId: {{fraudRequestId}}
}

headers {
  Content-Type: application/json
  request-id: {{request-id}}
  merchant-id: {{merchant-id}}
}

auth:bearer {
  token: {{auth-token}}
}
