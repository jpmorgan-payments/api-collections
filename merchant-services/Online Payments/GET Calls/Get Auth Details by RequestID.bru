meta {
  name: Get Auth Details by RequestID
  type: http
  seq: 8
}

get {
  url: {{online_url}}/payments?requestIdentifier={{authRequestId}}
  body: json
  auth: inherit
}

params:query {
  requestIdentifier: {{authRequestId}}
}

headers {
  Content-Type: application/json
  request-id: {{requestId}}
  merchant-id: {{merchantId}}
}

auth:bearer {
  token: {{auth-token}}
}
