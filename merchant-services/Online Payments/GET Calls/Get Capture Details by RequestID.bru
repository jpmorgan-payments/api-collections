meta {
  name: Get Capture Details by RequestID
  type: http
  seq: 5
}

get {
  url: {{online_url}}/captures?requestIdentifier={{captureRequestId}}
  body: json
  auth: inherit
}

params:query {
  requestIdentifier: {{captureRequestId}}
}

headers {
  Content-Type: application/json
  request-id: {{requestId}}
  merchant-id: {{merchantId}}
}

auth:bearer {
  token: {{auth-token}}
}
