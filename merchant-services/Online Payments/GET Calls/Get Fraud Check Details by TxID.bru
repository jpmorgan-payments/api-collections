meta {
  name: Get Fraud Check Details by TxID
  type: http
  seq: 7
}

get {
  url: {{online_url}}/fraudcheck/{{transactionId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{request-id}}
  merchant-id: {{merchant-id}}
}

auth:bearer {
  token: {{auth-token}}
}
