meta {
  name: Get Refund Details by RequestID
  type: http
  seq: 2
}

get {
  url: {{online_url}}/refunds?requestIdentifier={{refundRequestId}}
  body: json
  auth: inherit
}

params:query {
  requestIdentifier: {{refundRequestId}}
}

headers {
  Content-Type: application/json
  request-id: {{requestId}}
  merchant-id: {{merchantId}}
}

auth:bearer {
  token: {{auth-token}}
}
