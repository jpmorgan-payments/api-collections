meta {
  name: 04 Card - Safetech Fraud Check
  type: http
  seq: 4
}

post {
  url: {{online_url}}/fraudcheck
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{requestId}}
  merchant-id: {{merchantId}}
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
    "amount": 10000,
    "currency": "USD",
    "fraudScore": {
      "cardholderBrowserInformation": "{{$randomAbbreviation}}",
      "isFraudRuleReturn": true,
      "sessionId": "{{merchantOrderNumber}}",
      "fencibleItemAmount": 1230,
      "aNITelephoneNumber": "{{phoneNumber}}"
    },
    "accountHolder": {
      "deviceIPAddress": "{{$randomIPV4}}",
      "driverLicenseNumber": "T000-000-0000",
      "email": "{{$randomEmail}}",
      "fullName": "{{$randomFirstName}} {{$randomLastName}}",
      "referenceId": "{{merchantOrderNumber}}",
      "consumerIdCreationDate": "2027-08-02",
      "phone": {
        "countryCode": 1,
        "phoneNumber":{{phoneNumber}}
      },
      "billingAddress": {
        "line1": "{{$randomStreetAddress}}",
        "city": "{{$randomCity}}",
        "state": "{{$randomCountryCode}}",
        "postalCode": "33626"
      }
    },
    "paymentMethodType": {
      "card": {
        "expiry": {
          "month": 12,
          "year": 2027
        },
        "cvv":{{cvv}},
        "accountNumber": "{{testCardNum}}"
      }
    },
    "shipTo": {
      "shippingAddress": {
        "line1": "{{$randomStreetAddress}}",
        "city": "{{$randomCity}}",
        "state": "{{$randomCountryCode}}",
        "postalCode": "33626"
      },
      "shippingDescription": "C"
    },
    "merchant": {
      "merchantSoftware": {
        "companyName": "{{$randomCompanyName}}",
        "productName": "{{$randomProduct}}",
        "version": "2.0"
      }
    }
  }
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setVar("requestId", require("uuid").v4())

  // Generate merchantOrderNumber using UNIX timestamp and store in variable
  bru.setVar("merchantOrderNumber", Math.floor(Date.now() / 1000));
}

script:post-response {
  // Save the fraud transaction id (do not overwrite authTransactionId)
  if(res.body.transactionId) {
  bru.setVar("fraudTransactionId", res.body.transactionId);
  }

  // Set requestId to variable for further use
  if(res.body.requestId) {
  bru.setVar("fraudRequestId", res.body.requestId);
  }
}

assert {
  res.status: eq 200
  res.body.responseStatus: eq SUCCESS
}
