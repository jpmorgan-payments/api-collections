meta {
  name: 16 Auth-Capture (Apple Pay Bundle)
  type: http
  seq: 16
}

post {
  url: {{online_url}}/payments
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{requestId}}
  merchant-id: {{merchantId}}
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
    "captureMethod": "MANUAL",
    "amount": 1000,
    "isAmountFinal": true,
    "currency": "EUR",
    "initiatorType": "CARDHOLDER",
    "accountOnFile": "NOT_STORED",
    "merchant": {
      "merchantSoftware": {
        "companyName": "{{$randomCompanyName}}",
        "productName": "{{$randomProduct}}",
        "version": "2.0"
      }
    },
    "paymentMethodType": {
      "applepay": {
        "latLong": "1,1",
        "encryptedPaymentBundle": {
          "encryptedPayload": "",
          "encryptedPaymentHeader": {
            "ephemeralPublicKey": "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEpW8dBQ62HVRoMrTXEb1LnDx65SMdKC/pSzB9r2kc2ZQXlrsakDOpyM4Ck6dkoDa0fTOHdWL4i+tFVfJ7fMtfKw==",
            "publicKeyHash": "Fv4E8Vgyf1kpIjyMgDqOxaJiQGsUBFr3VyYSZwioEoM=",
            "walletTransactionId": "27ed51c15512070be3058fb6070c2e63ddd69ca2e75b3187e2af6faf92ba2901",
            "walletApplicationData": "27ed51c15512070be3058fb6070c2e63ddd69ca2e75b3187e2af6faf92ba2901"
          },
          "signature": "",
          "protocolVersion": "EC_v1"
        }
      }
    }
  }
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setVar("requestId", require("uuid").v4())
  
  // Generate merchantOrderNumber using UNIX timestamp and store in variable
  bru.setVar("merchantOrderNumber", Math.floor(Date.now() / 1000));
}

script:post-response {
  // Set transactionId to variable for further use
  if(res.body.transactionId) {
  bru.setVar("transactionId", res.body.transactionId);
  }
  
  // Set requestId to variable for further use
  if(res.body.requestId) {
  bru.setVar("authRequestId", res.body.requestId);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
