meta {
  name: 08 Get transaction by transaction Id
  type: http
  seq: 8
}

get {
  url: {{online_url}}/payments/{{LPMtransactionId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{requestId}}
  merchant-id: {{merchantId}}
}

script:pre-request {
  // Fresh request-id per call
  bru.setVar("requestId", require("uuid").v4());
}

auth:bearer {
  token: {{auth-token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
