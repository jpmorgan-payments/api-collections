meta {
  name: 07 Get transaction by request id
  type: http
  seq: 7
}

get {
  url: {{online_url}}/payments?requestIdentifier={{authLPMRequestId}}
  body: json
  auth: inherit
}

params:query {
  requestIdentifier: {{authLPMRequestId}}
}

headers {
  Content-Type: application/json
  request-id: {{requestId}}
  merchant-id: {{merchantId}}
}

script:pre-request {
  // Fresh request-id per call
  bru.setVar("requestId", require("uuid").v4());
}

auth:bearer {
  token: {{auth-token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
