meta {
  name: Auth-Capture (Level3 MC)
  type: http
  seq: 1
}

post {
  url: {{online_url}}/payments
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{request-id}}
  merchant-id: {{merchant-id}}
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
    "captureMethod": "NOW",
    "amount": 10000,
    "currency": "USD",
    "initiatorType": "CARDHOLDER",
    "accountOnFile": "NOT_STORED",
    "isAmountFinal": true,
    "paymentMethodType": {
      "card": {
        "accountNumber": "{{cardNum}}",
        "expiry": {
          "month": 7,
          "year": 2027
        },
        "merchantSalesChannelName": "INTERNET"
      }
    },
    "merchant": {
      "merchantSoftware": {
        "companyName": "{{$randomCompanyName}}.",
        "productName": "{{$randomProductName}}"
      }
    },
    "accountHolder": {
      "billingAddress": {
        "line1": "{{$randomStreetAddress}}",
        "line2": "{{$randomStreetAddress}}",
        "state": "{{$randomCountryCode}}",
        "city": "{{$randomCity}}",
        "countryCode": "USA"
      },
      "firstName": "{{$randomFirstName}}",
      "middleName": "{{$randomLastName}}",
      "lastName": "{{$randomLastName}}",
      "email": "{{$randomEmail}}",
      "phone": {
        "phoneNumber": "8888888888"
      }
    },
    "shipTo": {
      "shippingAddress": {
        "line1": "{{$randomStreetAddress}}",
        "line2": "{{$randomStreetAddress}}",
        "state": "{{$randomCountryCode}}",
        "city": "{{$randomCity}}",
        "countryCode": "USA"
      },
      "firstName": "{{$randomFirstName}}",
      "middleName": "{{$randomLastName}}",
      "lastName": "{{$randomLastName}}",
      "email": "{{$randomEmail}}",
      "phone": {
        "phoneNumber": "8888888888"
      }
    },
    "merchantOrderNumber": "{{merchantOrderNumber}}",
    "retailAddenda": {
      "purchaseOrderNumber": "{{merchantOrderNumber}}",
      "taxAmount": 1000,
      "isTaxable": true,
      "level3": {
        "totalShippingAmount": 1000,
        "dutyAmount": 1000,
        "shipToAddressPostalCode": "95134",
        "shipToAddressCountryCode": "USA",
        "shipFromAddressPostalCode": "33626",
        "alternateTaxAmount": 2000,
        "valueAddedTaxAmount": 1000,
        "valueAddedTaxPercent": 1300,
        "partyTaxGovernmentIssuedIdentifier": "{{$randomCompanyName}}",
        "lineItems": [
          {
            "lineItemDescriptionText": "{{$randomProduct}}",
            "merchantProductIdentifier": "{{$randomProduct}}",
            "itemComodityCode": "{{$randomCompanyName}}",
            "lineItemUnitQuantity": "1",
            "lineItemUnitofMeasureCode": "PIE",
            "unitPriceAmount": 500,
            "taxInclusiveLineItemTotalAmount": 7000,
            "transactionDiscountAmount": 2000,
            "lineItemTaxIndicator": true,
            "lineItemDiscountIndicator": true,
            "lineItemTaxes": [
              {
                "taxTypeCode": "01",
                "lineItemTaxAmount": 2000,
                "taxPercent": "0.05"
              }
            ]
          }
        ]
      }
    }
  }
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setEnvVar("request-id", require("uuid").v4())
  
  // Generate merchantOrderNumber using UNIX timestamp and store in variable
  bru.setEnvVar("merchantOrderNumber", Math.floor(Date.now() / 1000));
}

script:post-response {
  // Set transactionId to variable for further use
  if(res.body.transactionId) {
  bru.setEnvVar("transactionId", res.body.transactionId);
  }
  
  // Set requestId to variable for further use
  if(res.body.requestId) {
  bru.setEnvVar("authRequestId", res.body.requestId);
  }
}
