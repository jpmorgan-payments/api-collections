meta {
  name: Capture (with L3)
  type: http
  seq: 9
}

post {
  url: {{online_url}}/payments/{{transactionId}}/captures
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{request-id}}
  merchant-id: {{merchant-id}}
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
    "captureMethod": "NOW",
    "currency": "USD",
    "retailAddenda": {
      "purchaseOrderNumber": "",
      "level3": {
        "taxTreatmentCode": "0",
        "lineItems": [
          {
            "lineItemDetailCode": "0",
            "lineItemTaxes": [
              {
                "taxPercent": "0%",
                "taxTypeCode": "0",
                "lineItemTaxAmount": 0
              }
            ],
            "taxInclusiveLineItemTotalAmount": 5000,
            "purchaseTransactionDiscountPercent": "0",
            "lineItemDiscountTreatmentCode": "N",
            "lineItemDiscountIndicator": false,
            "lineItemTaxIndicator": false,
            "transactionDiscountAmount": 0,
            "lineItemUnitofMeasureCode": "UNIT",
            "itemComodityCode": "82101603",
            "unitPriceAmount": 5000,
            "lineItemUnitQuantity": "10000",
            "lineItemDescriptionText": "{{$randomProductAdjective}}",
            "merchantProductIdentifier": "{{$randomInt}}"
          }
        ],
        "valueAddedTaxInvoiceReferenceNumber": "{{$randomInt}}",
        "partyTaxGovernmentIssuedIdentifier": "0",
        "shippingValueAddedTaxAmount": 0,
        "totalTransactionDiscountAmount": 0,
        "shipFromAddressPostalCode": "94025-1452",
        "valueAddedTaxAmount": 0,
        "alternateTaxAmount": 0,
        "shippingValueAddedTaxPercent": "0",
        "valueAddedTaxPercent": "0",
        "orderDiscountTreatmentCode": "0",
        "shipToAddressPostalCode": "94025-1452",
        "shipToAddressCountryCode": "USA",
        "totalShippingAmount": 5000,
        "dutyAmount": 0
      },
      "orderDate": "2026-10-09",
      "isTaxable": false,
      "taxAmount": 0
    }
  }
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setEnvVar("request-id", require("uuid").v4())
  
  // Generate merchantOrderNumber using UNIX timestamp and store in variable
  bru.setEnvVar("merchantOrderNumber", Math.floor(Date.now() / 1000));
}

script:post-response {
  // Set transactionId to variable for further use
  if(res.body.transactionId) {
  bru.setEnvVar("transactionId", res.body.transactionId);
  }
  
  // Set requestId to variable for further use
  if(res.body.requestId) {
  bru.setEnvVar("captureRequestId", res.body.requestId);
  }
}
