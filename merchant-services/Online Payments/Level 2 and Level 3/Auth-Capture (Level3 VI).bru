meta {
  name: Auth-Capture (Level3 VI)
  type: http
  seq: 7
}

post {
  url: {{online_url}}/payments
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{request-id}}
  merchant-id: {{merchant-id}}
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
    "captureMethod": "NOW",
    "amount": 12000,
    "currency": "USD",
    "statementDescriptor": "{{$randomProductAdjective}}",
    "initiatorType": "CARDHOLDER",
    "accountOnFile": "STORED",
    "paymentMethodType": {
      "card": {
        "accountNumber": "{{cardNum}}",
        "expiry": {
          "month": 5,
          "year": 2040
        },
        "cvv": 123
      }
    },
    "recurring": {
      "recurringSequence": "FIRST"
    },
    "merchant": {
      "merchantSoftware": {
        "companyName": "{{$randomCompanyName}}",
        "productName": "{{$randomProduct}}",
        "version": "2.0"
      }
    },
    "accountHolder": {
      "billingAddress": {
        "line1": "{{$randomStreetAddress}}",
        "line2": "{{$randomStreetAddress}}",
        "state": "{{$randomCountryCode}}",
        "city": "{{$randomCity}}",
        "postalCode": "33626",
        "countryCode": "USA"
      },
      "firstName": "{{$randomFirstName}}",
      "lastName": "{{$randomLastName}}"
    },
    "retailAddenda": {
      "purchaseOrderNumber": "{{merchantOrderNumber}}",
      "orderDate": "2026-06-10",
      "taxAmount": 2000,
      "isTaxable": true,
      "level3": {
        "totalShippingAmount": 0,
        "dutyAmount": 0,
        "shipToAddressPostalCode": "33607",
        "shipToAddressCountryCode": "USA",
        "shipFromAddressPostalCode": "34490",
        "totalTransactionDiscountAmount": 0,
        "valueAddedTaxAmount": null,
        "valueAddedTaxPercent": null,
        "shippingValueAddedTaxPercent": null,
        "orderDiscountTreatmentCode": "2",
        "valueAddedTaxInvoiceReferenceNumber": "9999",
        "shippingValueAddedTaxAmount": null,
        "partyTaxGovernmentIssuedIdentifier": "30",
        "alternateTaxAmount": null,
        "lineItems": [
          {
            "lineItemDescriptionText": "{{$randomProduct}}",
            "merchantProductIdentifier": "041",
            "itemComodityCode": "1234",
            "lineItemUnitQuantity": "1",
            "lineItemUnitofMeasureCode": "UNIT",
            "unitPriceAmount": 10000,
            "taxInclusiveLineItemTotalAmount": 12000,
            "transactionDiscountAmount": 0,
            "purchaseTransactionDiscountPercent": "0",
            "lineItemDiscountTreatmentCode": "1",
            "lineItemDetailCode": "0",
            "lineItemTaxIndicator": true,
            "lineItemDiscountIndicator": false,
            "lineItemTaxes": [
              {
                "taxTypeCode": "0124",
                "lineItemTaxAmount": 2000,
                "taxPercent": "20%"
              }
            ]
          }
        ]
      }
    }
  }
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setEnvVar("request-id", require("uuid").v4())
  
  // Generate merchantOrderNumber using UNIX timestamp and store in variable
  bru.setEnvVar("merchantOrderNumber", Math.floor(Date.now() / 1000));
}

script:post-response {
  // Set transactionId to variable for further use
  if(res.body.transactionId) {
  bru.setEnvVar("transactionId", res.body.transactionId);
  }
  
  // Set requestId to variable for further use
  if(res.body.requestId) {
  bru.setEnvVar("authRequestId", res.body.requestId);
  }
}
