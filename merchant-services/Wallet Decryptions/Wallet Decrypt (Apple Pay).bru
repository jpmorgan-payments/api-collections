meta {
  name: Wallet Decrypt (Apple Pay)
  type: http
  seq: 3
}

post {
  url: {{online_url}}/wallet-decryptions
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{request-id}}
  merchant-id: {{merchant-id}}
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
    "encryptedPayloadText": "",
