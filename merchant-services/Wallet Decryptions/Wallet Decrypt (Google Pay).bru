meta {
  name: Wallet Decrypt (Google Pay)
  type: http
  seq: 1
}

post {
  url: {{online_url}}/wallet-decryptions
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{requestId}}
  merchant-id: {{merchantId}}
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
    "encryptedPayloadText": "{\"encryptedMessage\":\"\\u003d\\u003d\",\"ephemeralPublicKey\":\"BOn0Hz0PzJXBkmNqKwiGJw85THbRPFXRkocMC0quNbvjXu9XqVvzRzs0luXY2paaHK77L9GZyYCApvRqeUGNVHE\\u003d\",\"tag\":\"BycEuXvdD2iZNtzQpHOOkeVVSVVU/x5vveBEQH8T8n0\\u003d\"}",
    "walletProvider": "GOOGLE_PAY",
    "digitalSignature": "MEUCIQC122Jg88a0gMzGidKUuReuEHAZG6wgm1BOGsx4GqFTlQIgdyaTRY27n1HUpRAvyRq9ilF8zhJOKJIZ7X184YNkc4U=",
    "version": "ECv1"
  }
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setVar("requestId", require("uuid").v4())
}
