meta {
  name: Generate a report (Interchange Qualification report)
  type: http
  seq: 18
}

post {
  url: {{reporting_url}}/reports
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{requestId}}
  merchant-id: {{merchantId}}
}

auth:bearer {
  token: {{auth-token}}
}

