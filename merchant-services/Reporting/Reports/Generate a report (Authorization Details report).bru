script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setVar("requestId", require("uuid").v4())
  
  // Generate merchantOrderNumber using UNIX timestamp and store in variable
  bru.setVar("merchantOrderNumber", Math.floor(Date.now() / 1000));
  
  // Reporting window (local time): start = today-15d 00:00:00, end = today-1d 23:59:59
  const pad = (n) => String(n).padStart(2, "0");
  const daysAgo = (n) => { const d = new Date(); d.setDate(d.getDate() - n); return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; };
  bru.setVar("reportingPeriodStartTimestamp", `${daysAgo(15)} 00:00:00`);
  bru.setVar("reportingPeriodEndTimestamp", `${daysAgo(1)} 23:59:59`);
}

docs {
  [Reporting API](https://developer.payments.jpmorgan.com/api/commerce/optimization-protection/reporting/reporting)
}

settings {
  encodeUrl: true
  timeout: 0
}
