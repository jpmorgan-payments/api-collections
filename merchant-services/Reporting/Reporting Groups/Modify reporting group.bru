meta {
  name: Modify reporting group
  type: http
  seq: 3
}

patch {
  url: {{reportinggroups_url}}/reporting-groups/{{reportingGroupId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{requestId}}
  merchant-id: {{merchantId}}
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
    "reportingGroupType": "{{reportingGroupType}}",
    "reportingGroupName": "PRGTDZ",
    "reportingGroupDescription": "PRGTDZ",
    "childEntityInfo": [
      {
        "entityType": "PE",
        "entityIds": [
          {{merchantId}},
          {{reportingChildEntityId}}
        ]
      }
    ]
  }
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setVar("requestId", require("uuid").v4())
  
  // Generate merchantOrderNumber using UNIX timestamp and store in variable
  bru.setVar("merchantOrderNumber", Math.floor(Date.now() / 1000));
}

settings {
  encodeUrl: true
  timeout: 0
}
