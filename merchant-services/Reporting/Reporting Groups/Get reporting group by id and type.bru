meta {
  name: Get reporting group by id and type
  type: http
  seq: 6
}

get {
  url: {{reportinggroups_url}}/reporting-groups?groupId={{reportingGroupId}}&groupType={{reportingGroupType}}
  body: none
  auth: inherit
}

params:query {
  groupId: {{reportingGroupId}}
  groupType: {{reportingGroupType}}
}

headers {
  Content-Type: application/json
  request-id: {{requestId}}
  merchant-id: {{merchantId}}
}

auth:bearer {
  token: {{auth-token}}
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setVar("requestId", require("uuid").v4())
  
  // Generate merchantOrderNumber using UNIX timestamp and store in variable
  bru.setVar("merchantOrderNumber", Math.floor(Date.now() / 1000));
}

settings {
  encodeUrl: true
  timeout: 0
}
