meta {
  name: One Time Inquiry
  type: http
  seq: 1
}

post {
  url: {{accountupdater_url}}/account-updates
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{$guid}}
  merchant-id: {{merchantId}}
}

body:json {
  {
    "accountInformation": {
      "cardNumber": "5111111111111114",
      "expiry": {
        "month": 8,
        "year": 2026
      }
    }
  }
}

tests {
  // Set transactionId to variable for further use
  if(res.body.requestId) {
  bru.setVar("ccotqreqId", res.body.requestId);
  }
  
  if(res.body.responseId) {
  bru.setVar("ccotqrespId", res.body.responseId);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
