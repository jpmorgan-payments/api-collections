meta {
  name: One Time Inquiry - Get by response Id
  type: http
  seq: 3
}

get {
  url: {{accountupdater_url}}/account-updates/{{nmpbotqrespId}}
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{requestId}}
  merchant-id: {{merchantId}}
}

script:pre-request {
  // Fresh request-id per call
  bru.setVar("requestId", require("uuid").v4());
}

settings {
  encodeUrl: true
  timeout: 0
}