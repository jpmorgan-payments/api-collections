meta {
  name: CONTACT_CARDHOLDER
  type: http
  seq: 4
}

post {
  url: {{accountupdater_url}}/account-updates
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{request-id}}
  merchant-id: {{merchant-id}}
}

body:json {
  {
    "accountInformation": {
      "cardNumber": "5111111111111114",
      "expiry": {
        "month": 8,
        "year": 2026
      }
    },
    "cardAccountAction": "UNREGISTER"
  }
}

tests {
  // Set transactionId to variable for further use
  if(res.body.requestId) {
  bru.setEnvVar("ccurreqId", res.body.requestId);
  }
  
  if(res.body.responseId) {
  bru.setEnvVar("ccurrespId", res.body.responseId);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
