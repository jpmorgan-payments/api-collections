meta {
  name: NEW_EXPIRY
  type: http
  seq: 5
}

post {
  url: {{accountupdater_url}}/account-updates
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{$guid}}
  merchant-id: {{merchant-id}}
}

body:json {
  {
    "accountInformation": {
      "cardNumber": "5111111111111115",
      "expiry": {
        "month": 8,
        "year": 2026
      }
    }
  }
}

tests {
  // Set transactionId to variable for further use
  if(res.body.requestId) {
  bru.setEnvVar("neotqreqId", res.body.requestId);
  }
  
  if(res.body.responseId) {
  bru.setEnvVar("neotqrespId", res.body.responseId);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
