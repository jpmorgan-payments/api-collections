meta {
  name: MC - New Account (using Alphanumeric ST)
  type: http
  seq: 12
}

post {
  url: {{accountupdater_url}}/account-updates
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{$guid}}
  merchant-id: {{merchant-id}}
}

body:json {
  {
    "accountInformation": {
      "cardNumber": "530253VVHEFX0000",
      "expiry": {
        "month": 7,
        "year": 2026
      },
      "accountNumberType": "SAFETECH_TOKEN"
    }
  }
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setEnvVar("request-id", require("uuid").v4())
  
  // Generate merchantOrderNumber using UNIX timestamp and store in variable
  bru.setEnvVar("merchantOrderNumber", Math.floor(Date.now() / 1000));
}

tests {
  // Set transactionId to variable for further use
  if(res.body.requestId) {
  bru.setEnvVar("otnareqId", res.body.requestId);
  }
  
  if(res.body.responseId) {
  bru.setEnvVar("otnarespId", res.body.responseId);
  }
}
