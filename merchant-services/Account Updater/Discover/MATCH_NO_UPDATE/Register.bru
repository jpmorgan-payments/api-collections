meta {
  name: Register
  type: http
  seq: 4
}

post {
  url: {{accountupdater_url}}/account-updates
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{requestId}}
  merchant-id: {{merchantId}}
}

body:json {
  {
    "accountInformation": {
      "cardNumber": "6011111111111110",
      "expiry": {
        "month": 8,
        "year": 2026
      }
    },
    "cardAccountAction": "REGISTER",
    "merchantRecordIdentifier": "{{$guid}}"
  }
}

tests {
  // Set transactionId to variable for further use
  if(res.body.requestId) {
  bru.setVar("mnureqId", res.body.requestId);
  }
  
  if(res.body.responseId) {
  bru.setVar("mnurespId", res.body.responseId);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
