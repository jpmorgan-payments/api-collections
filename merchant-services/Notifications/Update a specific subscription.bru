meta {
  name: Update a specific subscription
  type: http
  seq: 4
}

put {
  url: {{notifications_url}}/subscriptions/{{subscriptionId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{requestId}}
  merchant-id: {{merchantId}}
  entity-type: MERCHANT
  entity-id: {{merchantId}}
  ~subscription-id: 
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
    "notifications": {
      "paymentUpdateNotification": [
        "All"
      ]
    },
    "callbackURL": "https://your-merchant-domain.example.com/notifications",
    "securityPreferences": {
      "webhookAuthorizationType": "token",
      "tokenEndpointAuthorizationType": "client_certificate_post",
      "mTLSEnabled": false,
      "authorizationDetails": {
        "tokenEndpoint": "https://idag2.jpmorganchase.com/adfs/oauth2/token/",
        "resourceId": "<YOUR_RESOURCE_ID>"
      }
    },
    "subscriptionChannels": [
      "WEBHOOK"
    ]
  }
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setVar("requestId", require("uuid").v4())
  
  // Generate merchantOrderNumber using UNIX timestamp and store in variable
  bru.setVar("merchantOrderNumber", Math.floor(Date.now() / 1000));
}
