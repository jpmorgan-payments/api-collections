meta {
  name: Only Access Token
  type: http
  seq: 13
}

post {
  url: {{idp_token_url}}
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: {{clientId}}
  resource: {{resourceId}}
  client_assertion_type: urn:ietf:params:oauth:client-assertion-type:jwt-bearer
  client_assertion: {{JWSPayload}}
}

script:post-response {
  bru.setEnvVar("auth-token", res.body.access_token);
}
