meta {
  name: JWT and Access Token
  type: http
  seq: 67
}

post {
  url: https://idag2.jpmorganchase.com/adfs/oauth2/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: {{clientId}}
  resource: {{resourceId}}
  client_assertion_type: urn:ietf:params:oauth:client-assertion-type:jwt-bearer
  client_assertion: {{JWSPayload}}
}

script:pre-request {
  var header = {
      typ : "JWT",  
      kid : bru.getEnvVar("kid")
  }
  
  const moment = require('moment');
  var data = {
  "iss": bru.getEnvVar("clientId"),
  "aud": "https://idag2.jpmorganchase.com/adfs/oauth2/token",
  "sub": bru.getEnvVar("clientId"),
  "iat": parseInt(new Date().getTime() / 1000),
  "exp": parseInt(new Date().getTime() / 1000) + (5 * 60),
  "jti": moment().format("YYMMDDHHmmss")
  }
  
  var jwt = require('jsonwebtoken');
  var sJWT = jwt.sign(data, bru.getEnvVar('gOauth_Priv_Key'), {algorithm: 'RS256', header: header});
  
  bru.setEnvVar("JWSPayload", sJWT);
}

script:post-response {
  bru.setEnvVar("auth-token", res.body.access_token);
}
