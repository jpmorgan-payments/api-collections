meta {
  name: Intent (Level 3 Example 3)
  type: http
  seq: 3
}

post {
  url: {{checkout_url}}/intent
  body: json
  auth: inherit
}

headers {
  merchantId: {{merchantId}}
  requestId: {{requestId}}
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
    "merchantOrderNumber": "{{merchantOrderNumber}}",
    "currencyCode": "USD",
    "cart": {
      "totalTransactionAmount": 3000,
      "taxAmount": 1500,
      "transactionDiscountAmount": 500,
      "discounts": [
        {
          "discountType": "DISCOUNT_TYPE_PROMOTION",
          "discountTypeDescription": "discount",
          "discountMode": "RATE_MODE_FLAT",
          "transactionDiscountAmount": 500,
          "promotionCode": "Summer Sale"
        }
      ],
      "taxes": [
        {
          "taxTypeCode": "TAX_TYPE_SHIPPING_VAT_TAX",
          "taxTypeDescription": "tax desc",
          "taxMode": "RATE_MODE_PERCENTAGE",
          "taxPercent": 10,
          "partyTaxGovernmentIssuedIdentifier": "pt01"
        },
        {
          "taxTypeCode": "TAX_TYPE_SHIPPING_VAT_TAX",
          "taxTypeDescription": "tax desc",
          "taxMode": "RATE_MODE_FLAT",
          "taxAmount": 250,
          "partyTaxGovernmentIssuedIdentifier": "pt01"
        },
        {
          "taxTypeCode": "TAX_TYPE_VAT",
          "taxTypeDescription": "tax desc",
          "taxMode": "RATE_MODE_PERCENTAGE",
          "taxPercent": 10,
          "partyTaxGovernmentIssuedIdentifier": "pt01"
        },
        {
          "taxTypeCode": "TAX_TYPE_VAT",
          "taxTypeDescription": "tax desc",
          "taxMode": "RATE_MODE_FLAT",
          "taxAmount": 250,
          "partyTaxGovernmentIssuedIdentifier": "pt01"
        },
        {
          "taxTypeCode": "TAX_TYPE_ALTERNATE_TAX",
          "taxTypeDescription": "tax desc",
          "taxMode": "RATE_MODE_FLAT",
          "taxAmount": 250,
          "partyTaxGovernmentIssuedIdentifier": "pt01"
        },
        {
          "taxTypeCode": "TAX_TYPE_IMPORT_TAX",
          "taxTypeDescription": "tax desc",
          "taxMode": "RATE_MODE_FLAT",
          "taxAmount": 150,
          "partyTaxGovernmentIssuedIdentifier": "pt01"
        }
      ],
      "transactionAdvices": [
        "TXN_01",
        "TXN_02"
      ],
      "totalShippingAmount": "100",
      "taxTreatmentCode": "TTC",
      "lineItems": [
        {
          "id": "{{merchantOrderNumber}}_01",
          "quantity": 1,
          "unitPrice": 1000,
          "imageUrl": "https://your-domain.example.com/images/product.jpg",
          "taxable": true,
          "shippable": true,
          "taxInclusiveLineItemTotalAmount": 1500,
          "transactionDiscountAmount": 200,
          "totalTaxAmount": 400,
          "product": {
            "merchantProductIdentifier": "MPI01",
            "productName": "Men's Casual Shirt",
            "productDescription": "A comfortable and stylish shirt",
            "imageUrl": "https://your-domain.example.com/images/product.jpg",
            "isTaxable": true,
            "shippable": true,
            "itemCommodityCode": "ICC011",
            "stockKeepingUnit": "SKU01"
          },
          "taxes": [
            {
              "taxTypeCode": "TAX_TYPE_STATE_SALES_TAX",
              "taxTypeDescription": "tax desc",
              "taxMode": "RATE_MODE_FLAT",
              "taxAmount": 250,
              "partyTaxGovernmentIssuedIdentifier": "pt01"
            },
            {
              "taxTypeCode": "TAX_TYPE_STATE_SALES_TAX",
              "taxTypeDescription": "tax desc",
              "taxMode": "RATE_MODE_PERCENTAGE",
              "taxPercent": 10,
              "partyTaxGovernmentIssuedIdentifier": "pt01"
            }
          ]
        },
        {
          "id": "{{merchantOrderNumber}}_02",
          "quantity": 1,
          "unitPrice": 1000,
          "name": "Men's Casual Shirt",
          "description": "A comfortable and stylish",
          "imageUrl": "https://your-domain.example.com/images/product.jpg",
          "taxable": true,
          "shippable": true,
          "taxInclusiveLineItemTotalAmount": 1500,
          "transactionDiscountAmount": 200,
          "totalTaxAmount": 400
        }
      ],
      "shippingAddress": {
        "recipientFullName": "{{$randomFullName}}",
        "line1": "{{$randomStreetAddress}}",
        "city": "{{$randomCity}}",
        "state": "CA",
        "country": "US",
        "postalCode": "95111"
      },
      "shipFromAddressPostalCode": "95111"
    },
    "consumer": {
      "email": "{{$randomEmail}}",
      "billingAddress": {
        "recipientFullName": "{{$randomFullName}}",
        "line1": "{{$randomStreetAddress}}",
        "city": "{{$randomCity}}",
        "state": "CA",
        "country": "US",
        "postalCode": "95111"
      }
    },
    "checkoutOptions": {
      "authorization": {
        "authorizationType": "AUTH_METHOD_CART_AMOUNT"
      },
      "capture": {
        "captureMethod": "CAPTURE_METHOD_NOW"
      },
      "consumerProfileOptions": {
        "isSaveConsumerProfile": "false"
      }
    },
    "purchaseOrderNumber": "{{merchantOrderNumber}}",
    "merchantSalesChannelName": "ORDER_CHANNEL_TYPE_WEB",
    "orderDate": "2027-05-08"
  }
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setVar("requestId", require("uuid").v4().slice(1,20))
  
  // Generate merchantOrderNumber using UNIX timestamp and store in variable
  bru.setVar("merchantOrderNumber", Math.floor(Date.now() / 1000));
}
