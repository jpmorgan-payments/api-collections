meta {
  name: PBL Create Product
  type: http
  seq: 1
}

post {
  url: {{checkout_url_0}}/catalog/products/
  body: json
  auth: inherit
}

headers {
  merchantId: {{merchantId}}
  requestId: {{requestId}}
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
      "name": "{{$randomProductName}}",
      "sku": "SKU-{{$randomAlphaNumeric}}{{$randomAlphaNumeric}}{{$randomAlphaNumeric}}{{$randomAlphaNumeric}}{{$randomAlphaNumeric}}{{$randomAlphaNumeric}}",
      "description": "Product Desc {{$randomLoremSentence}}"
  }
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setVar("requestId", require("uuid").v4())
  
  // Generate merchantOrderNumber using UNIX timestamp and store in variable
  bru.setVar("merchantOrderNumber", Math.floor(Date.now() / 1000));
}

tests {
  //Saving the product id in a variable
  if(res.body.product.productId){
  bru.setVar("checkout_productID",res.body.product.productId);
  }
}
