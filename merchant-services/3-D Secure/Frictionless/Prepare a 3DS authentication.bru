meta {
  name: Prepare a 3DS authentication
  type: http
  seq: 1
}

post {
  url: {{3ds_url}}/authentications
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{requestId}}
  merchant-id: {{merchantId}}
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
    "authenticationPaymentMethodType": {
      "card": {
        "expiry": {
          "month": 5,
          "year": 2027
        },
        "accountNumber": "{{testCardNum}}"
      }
    },
    "amount": 54500,
    "currency": "EUR",
    "authenticationAccount": {
      "email": "{{$randomEmail}}",
      "firstName": "{{$randomFirstName}}",
      "lastName": "{{$randomLastName}}",
      "middleName": "{{$randomFirstName}}",
      "phone": {
        "countryCode": 1,
        "phoneNumber": "8888888888"
      },
      "billingAddress": {
        "line1": "123 Some Street",
        "line2": "Apartment 3b",
        "state": "FL",
        "city": "Clearwater",
        "postalCode": "33607",
        "countryCode": "USA",
        "addressTypeCode": "Doing Business As Address"
      }
    },
    "shippingAddress": {
      "line1": "123 Some Street",
      "line2": "Apartment 3b",
      "state": "FL",
      "city": "Clearwater",
      "postalCode": "33607",
      "countryCode": "USA",
      "addressTypeCode": "Doing Business As Address"
    },
    "threeDSMethodMerchantNotificationUrl": "https://your-merchant-domain.example.com/3ds/method-notification",
    "authenticationType": "AUTHENTICATION"
  }
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setVar("requestId", require("uuid").v4())
  
  // Generate merchantOrderNumber using UNIX timestamp and store in variable
  bru.setVar("merchantOrderNumber", Math.floor(Date.now() / 1000));
}

tests {
  
  // Set transactionId to variable for further use
  if(res.body.transactionId) {
  bru.setVar("transactionId", res.body.transactionId);
  }
  
  
  // Set 3DS Auth ID to variable for further use
  if(res.body.authenticationId) {
  bru.setVar("3dsauthid", res.body.authenticationId);
  }
}
