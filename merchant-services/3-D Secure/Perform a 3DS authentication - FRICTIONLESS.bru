meta {
  name: Perform a 3DS authentication - FRICTIONLESS
  type: http
  seq: 2
}

post {
  url: {{3ds_url}}/authentications/{{3dsauthid}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{request-id}}
  merchant-id: {{merchant-id}}
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
    "accountType": "CREDIT",
    "channelType": "BROWSER",
    "messageType": "PAYMENT_AUTHENTICATION",
    "threeDSChallengeMerchantNotificationUrl": "https://your-merchant-domain.example.com/3ds/challenge-notification",
    "authenticationSupportUrl": "https://your-merchant-domain.example.com/3ds/authentication-support",
    "threeDSAccountAdditionalInfo": {
