meta {
  name: 02 Challenge
  type: http
  seq: 2
}

post {
  url: {{disputes_url}}/disputes/{{disputeId}}/challenge
  body: json
  auth: inherit
}

headers {
  request-id: {{uuid}}
  merchant-id: {{merchantId}}
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
    "last4CardNumber": "{{cardLast4}}",
    "supportingDocuments": [
      {
        "documentName": "Test_doc.pdf",
        "documentContent": ""
      }
    ]
  }
}

script:pre-request {
  bru.setVar("uuid", require("uuid").v4());
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  [Disputes API](https://developer.payments.jpmorgan.com/api/commerce/optimization-protection/dispute-management/dispute-management#/operations/challengeDispute)
}
