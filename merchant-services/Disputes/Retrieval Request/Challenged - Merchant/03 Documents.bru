meta {
  name: 03 Documents
  type: http
  seq: 3
}

get {
  url: {{disputes_url}}/disputes/{{disputeId}}/documents
  body: none
  auth: inherit
}

headers {
  request-id: {{uuid}}
  merchant-id: {{merchantId}}
}

auth:bearer {
  token: {{auth-token}}
}

script:pre-request {
  bru.setVar("uuid", require("uuid").v4());
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  [Disputes API](https://developer.payments.jpmorgan.com/api/commerce/optimization-protection/dispute-management/dispute-management#/operations/getDisputeDocuments)
}
