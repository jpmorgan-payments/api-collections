meta {
  name: Create Profile (Card)
  type: http
  seq: 1
}

post {
  url: {{consumerprofile_url}}/consumer-profiles
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  requestIdentifier: {{request-id}}
  merchantIdentifier: {{merchant-id}}
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
      "externalConsumerProfileIdentifier": "{{merchantOrderNumber}}",
      "cardOnFileReferenceNumber": "123",
      "firstName": "{{$randomFirstName}}",
      "lastName": "{{$randomLastName}}",
      "profileStatus": "ACTIVE",
      "consumerProfileAddresses": [
          {
              "firstName": "{{$randomFirstName}}",
              "lastName": "{{$randomLastName}}",
              "consumerAssignedAddressName": "Work",
              "primaryAddressIndicator": true,
              "addressType": "SHIPPING",
              "line1": "400 Elton Farm",
              "line2": "Apt 123",
              "city": "Glen Mills",
              "state": "PA",
              "postalCode": "19342",
              "countryCode": "USA",
              "addressStatus": "ACTIVE"
          }
      ],
      "profilePaymentMethod": {
          "cardList": [
              {
                  "cardExpirationMonthYearNumber": "01/2027",
                  "accountNumber": "{{cardNum}}",
                  "accountStatus": "ACTIVE",
                  "cardType": "MC",
                  "firstName": "{{$randomFirstName}}",
                  "lastName": "{{$randomLastName}}"
              }
          ]
      },
      "communication": {
          "phoneList": [
              {
                  "phoneNumber": "8888888888",
                  "countryCode": "840",
                  "phoneNumberType": "Home"
              }
          ],
          "emailList": [
              {
                  "emailAddress": "{{$randomEmail}}",
                  "emailAddressType": "Home"
              }
          ]
      }
  }
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setEnvVar("request-id", require("uuid").v4())
  
  // Generate merchantOrderNumber using UNIX timestamp and store in variable
  bru.setEnvVar("merchantOrderNumber", Math.floor(Date.now() / 1000));
}

tests {
  // Set consumer profile id to variable for further use
  if(res.body.consumerProfileId) {
  bru.setEnvVar("consumerprofileid", res.body.consumerProfileId);
  }
  
  // Set consumer profile address to variable for further use
  
  if(Array.isArray(res.body.addresses) && res.body.addresses.length > 0)
  {
  var firstelement = res.body.addresses[1].addressIdentifier;
  bru.setEnvVar("consumerprofileaddressid",JSON.stringify(firstelement));
  let ogvalue = bru.getEnvVar("consumerprofileaddressid");
  let modvalue = ogvalue.replace(/"/g,'');
  bru.setEnvVar("consumerprofileaddressid",modvalue);
  }
  
  // Set default payment method ID to variable for further use
  if(res.body.paymentMethodType.defaultMOP.card.paymentMethodId) {
  bru.setEnvVar("consumerprofilepymntID", res.body.paymentMethodType.defaultMOP.card.paymentMethodId);
  }
  
  
  
}
