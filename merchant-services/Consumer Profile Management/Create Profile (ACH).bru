meta {
  name: Create Profile (ACH)
  type: http
  seq: 4
}

post {
  url: {{consumerprofile_url}}/consumer-profiles
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  requestIdentifier: {{requestId}}
  merchantIdentifier: {{merchantId}}
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
    "externalConsumerProfileIdentifier": "{{merchantOrderNumber}}",
    "cardOnFileReferenceNumber": "123",
    "firstName": "{{$randomFirstName}}",
    "lastName": "{{$randomLastName}}",
    "profileStatus": "ACTIVE",
    "consumerProfileAddresses": [
      {
        "firstName": "{{$randomFirstName}}",
        "lastName": "{{$randomLastName}}",
        "consumerAssignedAddressName": "Work",
        "primaryAddressIndicator": true,
        "addressType": "SHIPPING",
              "line1": "{{$randomStreetAddress}}",
        "line2": "Apt 123",
        "city": "{{$randomCity}}",
        "state": "PA",
        "postalCode": "19342",
        "countryCode": "USA",
        "addressStatus": "ACTIVE"
      }
    ],
    "profilePaymentMethod": {
      "achList": [
        {
          "accountNumber": "{{accountNumber}}",
          "financialInstitutionRoutingNumber": "{{routingNumber}}",
          "paymentType": "WEB",
          "accountStatus": "ACTIVE",
          "firstName": "{{$randomFirstName}}",
          "lastName": "{{$randomLastName}}"
        }
      ]
    },
    "communication": {
      "phoneList": [
        {
          "phoneNumber":{{phoneNumber}},
          "countryCode": "840",
          "phoneNumberType": "Home"
        }
      ],
      "emailList": [
        {
          "emailAddress": "{{$randomEmail}}",
          "emailAddressType": "Home"
        }
      ]
    }
  }
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setVar("requestId", require("uuid").v4())
  
  // Generate merchantOrderNumber using UNIX timestamp and store in variable
  bru.setVar("merchantOrderNumber", Math.floor(Date.now() / 1000));
  
  const acct = Math.floor(Math.random() * 1e10);
  bru.setVar('accountNumber', String(acct).padStart(10, '0'));
  
  const w = [3, 7, 1, 3, 7, 1, 3, 7];                 // ABA weights for the first 8 digits
  const d = Array.from({ length: 8 }, () => Math.floor(Math.random() * 10));
  const sum = d.reduce((acc, digit, i) => acc + digit * w[i], 0);
  const check = (10 - (sum % 10)) % 10;               // 9th digit satisfies the ABA checksum
  bru.setVar('routingNumber', d.join('') + String(check));
  
}
