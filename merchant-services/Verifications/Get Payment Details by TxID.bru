meta {
  name: Get Payment Details by TxID
  type: http
  seq: 5
}

get {
  url: {{online_url}}/verifications/{{transactionId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  merchant-id: {{merchantId}}
  ~request-id: {{requestId}}
}

auth:bearer {
  token: {{auth-token}}
}
