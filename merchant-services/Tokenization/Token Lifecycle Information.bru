meta {
  name: Token Lifecycle Information
  type: http
  seq: 4
}

get {
  url: {{token_url}}/tokens/{{tokenReferenceIdentifier}}/lifecycle-states
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{requestId}}
  merchant-id: {{merchantId}}
}

auth:bearer {
  token: {{auth-token}}
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setVar("requestId", require("uuid").v4())
  
  
}
