meta {
  name: Token Request (Safetech)
  type: http
  seq: 2
}

post {
  url: {{token_url}}/acquirerToken
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  request-id: {{requestId}}
  merchant-id: {{merchantId}}
}

auth:bearer {
  token: {{auth-token}}
}

body:json {
  {
    "accountInformation": {
      "cardNumber": "{{testCardNum}}",
      "cardSource": "KEY_ENTERED"
    }
  }
}

script:pre-request {
  // Generate GUID for requestId and store it in a variable that could be used for other things (refund, void, sale, etc)
  bru.setVar("requestId", require("uuid").v4())
  
  // Generate merchantOrderNumber using UNIX timestamp and store in variable
  bru.setVar("merchantOrderNumber", Math.floor(Date.now() / 1000));
}

tests {
  // Set tokenNumber to variable for further use
  if(res.body.tokenInformation.acquirerTokenNumber){
  bru.setVar("tokenNumber",res.body.tokenInformation.acquirerTokenNumber);
  }
  
  // Set token reference ID to variable for further use
  if(res.body.identifier){
  bru.setVar("tokenReferenceIdentifier",res.body.identifier);
  }
}
