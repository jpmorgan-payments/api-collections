vars {
  @description('Online Payments API base URL (v2) for card, wallet, and alternative payment processing — CAT/test')
  online_url: https://api-ms-test.payments.jpmorgan.com/api/v2
  @description('Tokenization (Safetech) service base URL for exchanging card data for network/merchant tokens — CAT/test')
  token_url: https://api-tokens-cat.payments.jpmorgan.com
  @description('Checkout API base URL including the /checkout path for hosted and drop-in checkout sessions — CAT/test')
  checkout_url: https://merchant-api.checkout-cat.merchant.jpmorgan.com/v1/checkout
  @description('Checkout API root base URL (v1, without the /checkout path) for products and payment links — CAT/test')
  checkout_url_0: https://merchant-api.checkout-cat.merchant.jpmorgan.com/v1
  @description('Consumer Profile Management (MMP) API base URL for storing and reusing consumer profiles — CAT/test')
  consumerprofile_url: https://profiles-api-test.merchant.jpmorgan.com/api/v2/mmp
  @description('Account Updater API base URL (v1) for retrieving updated card credentials from the networks — CAT/test')
  accountupdater_url: https://api-ms-test.payments.jpmorgan.com/api/v1
  @description('3-D Secure authentication API base URL (v2) for cardholder authentication requests — CAT/test')
  3ds_url: https://api-ms-test.payments.jpmorgan.com/api/v2
  @description('Notification Subscription service base URL for managing webhook event subscriptions — CAT/test')
  notifications_url: https://mns-aws-cat.jpmchase.com/v1
  @description('Default test card number (PAN) used across sample requests via {{testCardNum}}')
  testCardNum: 4112344112344113
}
vars:secret [
  @description('Authorization token, auto-created by JWT and Access Token request')
  auth-token,
  @description('OAuth2 client identifier issued in the Developer Portal; sent as client_id and as the JWT issuer/subject')
  clientId,
  @description('Key ID (kid) header for the signed JWT client assertion, identifying the signing key registered with J.P. Morgan')
  kid,
  @description('Merchant identifier sent in the merchant-id header and used for per-merchant entitlement checks')
  merchantId,
  @description('RSA private key used to RS256-sign the JWT client assertion; user-supplied and never sent to the API')
  gOauth_Priv_Key,
  @description('Signed JWT client assertion (client_assertion), auto-generated by the JWT and Access Token request')
  JWSPayload,
  @description('OAuth2 resource identifier requested during the token exchange (sent as the resource parameter)')
  resourceId,
  @description('Platform identifier for platform/partner (payment facilitator) integrations')
  platformId
]
color: #2E8A54
